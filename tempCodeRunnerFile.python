import matplotlib.pyplot as plt
import matplotlib.patches as patches


# 1. Create a figure and axes
fig, ax = plt.subplots(1, 1)

# 2. Define the list of rectangles to plot (x, y, width, height, color)
rectangles_data = [
    (-6.5, 6.5, 14, 21, 'red'),
    (-6, -17, 52, 61, 'blue'),
    (6.5, 18.5, 35, 43, 'green'),
    ]

for x, y, width, height, color in rectangles_data:
    # Create the rectangle patch
    rect = patches.Rectangle((x, y), width, height, facecolor=color, edgecolor='black')
    # Add the patch to the axes
    ax.add_patch(rect)

# 4. Adjust axis limits to ensure all rectangles are visible
# Add some padding to the limits for better viewing
ax.set_xlim(0, 150)
ax.set_ylim(0, 150)

# Optional: Add a title and labels
ax.set_xlabel("X-axis")
ax.set_ylabel("Y-axis")
ax.set_title("Multiple Rectangles Plot")
ax.set_aspect('equal', adjustable='box') # Keeps rectangles square/proportional

# 5. Display the plot
plt.show()
